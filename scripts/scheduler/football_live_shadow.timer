[Unit]
Description=Trigger Football Intelligence Live Shadow Execution Every 6 Hours
Requires=football_live_shadow.service

[Timer]
# Run every 6 hours (00:00, 06:00, 12:00, 18:00 UTC) with randomized delay to prevent provider thundering herds
OnCalendar=00/6:00:00 UTC
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
